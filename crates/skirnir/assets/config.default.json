        "accent_motion": "#FF7A1A",
        "text": "#E4E4E4",
        "text_dim": "#9A9A9A",
        "text_disabled": "#5C5C5C",
        "state_idle": "#3B82C4",
        "state_run": "#3FB861",
        "state_hold": "#E0A33E",
