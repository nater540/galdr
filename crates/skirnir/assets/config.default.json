  "toolpath": {
    "cut_stroke_px": 1.6,
    "rapid_stroke_px": 1.0,
    "trail_break_fraction": 0.12,
    "arc_step_deg": 9.0,
    "grid_minor_px": 16.0,
    "grid_major_every": 5,
    "marker_radius_px": 4.0
